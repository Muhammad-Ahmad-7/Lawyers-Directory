# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/lawyer_schedule?schema=public"

# Random secret for signing sessions. Generate with: npx auth secret  (or any long random string)
AUTH_SECRET="change-me-to-a-long-random-string"

# Timezone the lawyer works in (decides what "today" is). Required on Vercel, which runs in UTC.
APP_TIMEZONE="Asia/Karachi"
